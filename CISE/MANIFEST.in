include LICENSE README.md THIRD_PARTY_NOTICES.md .gitignore
recursive-include configs *.json *.txt
recursive-include docs *.md
recursive-include provenance *.json
recursive-include tests *.py
recursive-include scripts *.py
recursive-include .github *.yml
prune .venv
prune .local
prune runs
prune assets
prune build
prune dist
global-exclude *.pyc __pycache__ *.egg-info
